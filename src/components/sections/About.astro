---
import PixelBackground from '../ui/PixelBackground.vue';
import { PERSONAL_INFO, EDUCATION, SKILLS } from '../../data/constants';
---

<section id="about" class="py-16 px-4 relative overflow-hidden">
  <PixelBackground client:idle />

  <div class="max-w-4xl mx-auto space-y-10 relative z-10">
    <div class="text-center space-y-4">
      <h2 class="text-3xl md:text-5xl font-bold text-gray-800 dark:text-white font-pixel">
        &lt; SOBRE_MI /&gt;
      </h2>
      <div class="h-1 w-24 bg-primary mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-10 items-start">
      <!-- Profile Image Column -->
      <div class="flex flex-col items-center space-y-6">
        <div class="relative group">
          <div class="absolute inset-0 bg-secondary translate-x-2 translate-y-2 pixel-card rounded-none"></div>
          <div class="pixel-card relative bg-gray-200 w-60 h-60 overflow-hidden border-4 border-black dark:border-primary">
            <img
              src={PERSONAL_INFO.profileImage}
              alt={PERSONAL_INFO.shortName}
              class="w-full h-full object-cover pixelated hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="space-y-6">
        <div class="pixel-card p-6 bg-white/90 dark:bg-black/60">
          <p class="text-base md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed font-pixel">
            {PERSONAL_INFO.bio}
          </p>
        </div>

        <!-- Education -->
        <div class="space-y-3">
          <h3 class="text-xl font-bold text-secondary font-pixel">[ FORMACIÓN ]</h3>
          {EDUCATION.map((item) => (
            <div class="flex items-center gap-3">
              <span class={`w-3 h-3 ${item.color} pixel-btn flex-shrink-0`}></span>
              <span class="text-gray-700 dark:text-gray-300 font-pixel text-base md:text-lg">
                {item.text}
              </span>
            </div>
          ))}
        </div>

        <!-- Skills -->
        <div class="space-y-4 pt-2">
          <h3 class="text-xl md:text-2xl font-bold text-primary font-pixel">
            [ SKILLS & HERRAMIENTAS ]
          </h3>
          <div class="flex flex-wrap gap-2 md:gap-3">
            {SKILLS.map((skill) => (
              <span
                class="px-3 py-1.5 bg-white/50 dark:bg-white/10 border-2 border-primary/30 rounded-none text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary transition-all duration-300 font-pixel text-sm md:text-base cursor-default"
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
