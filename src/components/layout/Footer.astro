---
import { PERSONAL_INFO } from '../../data/constants';
const currentYear = new Date().getFullYear();
---

<footer class="py-8 text-center text-gray-500 dark:text-gray-400 text-sm font-pixel border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
    <p>&copy; {currentYear} {PERSONAL_INFO.name}.</p>
    <div class="flex items-center gap-4 text-xs">
      <span class="text-primary font-pixel">[ ASTRO + VUE 3 ]</span>
      <span class="text-secondary font-pixel">[ THREE.JS ]</span>
      <span class="text-accent font-pixel">[ TAILWIND ]</span>
    </div>
  </div>
</footer>
