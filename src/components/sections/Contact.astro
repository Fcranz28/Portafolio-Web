---
import PixelBackground from '../ui/PixelBackground.vue';
import { PERSONAL_INFO } from '../../data/constants';
---

<section id="contact" class="py-16 px-4 relative overflow-hidden">
  <PixelBackground client:idle />
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto text-center space-y-10 relative z-10">
    <div class="space-y-4">
      <h2 class="text-3xl md:text-5xl font-bold text-gray-800 dark:text-white font-pixel">
        &lt; CONTACTO /&gt;
      </h2>
      <div class="h-1 w-24 bg-primary mx-auto"></div>
      <p class="text-gray-600 dark:text-gray-300 font-pixel text-xl">
        [ DISPONIBLE PARA PROYECTOS Y OPORTUNIDADES ]
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Email -->
      <a
        href={`mailto:${PERSONAL_INFO.email}`}
        class="pixel-card p-6 md:p-8 flex flex-col items-center gap-4 bg-white/95 dark:bg-black/60 group no-underline hover:-translate-y-1 transition-transform"
      >
        <div class="p-4 border-2 border-primary bg-primary/5 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <rect width="20" height="16" x="2" y="4" rx="0" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
        </div>
        <h3 class="font-bold text-gray-800 dark:text-white font-pixel text-xl md:text-2xl">GMAIL</h3>
        <span class="text-sm md:text-base text-gray-600 dark:text-gray-400 font-pixel break-all">{PERSONAL_INFO.email}</span>
      </a>

      <!-- LinkedIn -->
      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="pixel-card p-6 md:p-8 flex flex-col items-center gap-4 bg-white/95 dark:bg-black/60 group no-underline hover:-translate-y-1 transition-transform"
      >
        <div class="p-4 border-2 border-secondary bg-secondary/5 text-secondary group-hover:bg-secondary group-hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" />
          </svg>
        </div>
        <h3 class="font-bold text-gray-800 dark:text-white font-pixel text-xl md:text-2xl">LINKEDIN</h3>
        <span class="text-sm md:text-base text-gray-600 dark:text-gray-400 font-pixel">{PERSONAL_INFO.shortName}</span>
      </a>

      <!-- Phone -->
      <a
        href={`tel:${PERSONAL_INFO.phone.replace(/\s+/g, '')}`}
        class="pixel-card p-6 md:p-8 flex flex-col items-center gap-4 bg-white/95 dark:bg-black/60 group no-underline hover:-translate-y-1 transition-transform"
      >
        <div class="p-4 border-2 border-accent bg-accent/5 text-accent group-hover:bg-accent group-hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </div>
        <h3 class="font-bold text-gray-800 dark:text-white font-pixel text-xl md:text-2xl">WHATSAPP / TEL</h3>
        <span class="text-sm md:text-base text-gray-600 dark:text-gray-400 font-pixel">{PERSONAL_INFO.phone}</span>
      </a>
    </div>
  </div>
</section>
